# ── Broker ────────────────────────────────────────────────────────────────────
# Options: alpaca_paper   (paper-only public build — live brokers are removed)
BROKER=alpaca_paper

# Required when BROKER starts with "alpaca".
# Generate at https://app.alpaca.markets → Settings → API Keys
ALPACA_API_KEY=replace-me
ALPACA_SECRET_KEY=replace-me

# ── Storage ───────────────────────────────────────────────────────────────────
SQLITE_PATH=./data/investor.db
TARGETS_PATH=./config/targets.yaml

# ── Operational ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
TZ=America/New_York

# ── Phase 2+ ──────────────────────────────────────────────────────────────────
# Admin token protects /admin/* endpoints.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=
ANTHROPIC_API_KEY=        # from console.anthropic.com
MAGIC_LINK_SECRET=        # openssl rand -hex 32  (distinct from ADMIN_TOKEN)
APP_BASE_URL=http://localhost:8000
FINNHUB_API_KEY=        # from https://finnhub.io (free tier, 60 req/min)

# ── Phase 1+ (leave empty for Phase 0) ───────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
LLM_BACKEND=        # agent_sdk | anthropic_api (default)
BARS_DIR=data/bars

# ── Phase 3+ — LLM knobs (all optional; defaults shown) ───────────────────────
LLM_DAILY_COST_CAP_USD=3.0
LLM_CLI_PATH=             # claude CLI override for LLM_BACKEND=agent_sdk; empty = bundled
LEVEL_PROMPT_VERSION=v2   # S/R level-scoring prompt
NEWS_CLASSIFY_MODEL=      # empty = Haiku default
NEWS_CRITIC_MODEL=        # empty = Sonnet default
NEWS_ARBITRATE_MODEL=     # empty = Sonnet default

# ── Weekly reflection (optional, OFF by default) ──────────────────────────────
# Adds a "lessons from this week" section to the Friday weekly-review email: it reads
# the week's resolved suggestions (filled / expired / rejected) against current prices
# and asks Sonnet for generalizable methodology lessons.
#
# Cost: one Sonnet call per active broker account, every week.
# What it buys: an email section, and nothing else. The insights are read back ONLY by
# the next reflection run — they never reach the suggestion engine, the sizing logic, or
# any order path. Turning this on will not change what the system suggests or trades.
REFLECTION_ENABLED=false
REFLECTION_PRIOR_INSIGHTS_COUNT=8   # prior lessons fed back as context
REFLECTION_PROMPT_VERSION=1

AUTO_TRADE_PROMOTION_TOKEN=   # openssl rand -hex 32  (separate from ADMIN_TOKEN)

# ── Phase 4.5 — Tavily weekly market context (leave empty to skip section) ─────
TAVILY_API_KEY=       # from https://tavily.com (free tier: 1 000 searches/month)
TAVILY_MONTHLY_CAP=200
WEEKLY_CONTEXT_PROMPT_VERSION=v1

# ── Phase 4.7 — context-aware sizing (all optional; defaults shown) ────────────
EARNINGS_SIZE_FACTOR=0.5
EARNINGS_REANCHOR=true
EARNINGS_LOOKAHEAD_DAYS=7
CONTEXT_SIZE_MIN=0.25
CONTEXT_SIZE_MAX=1.5
CONTEXT_MAX_AGE_DAYS=4
CONTEXT_ADJUST_PROMPT_VERSION=v1
CRITIC_PROMPT_VERSION=v2

# ── Phase 4.8 — weekly order-activity metrics (optional; defaults shown) ───────
WEEKLY_REVIEW_TREND_WEEKS=4
WEEKLY_REVIEW_BREAKDOWN_TOP_N=20

# ── Soak-window P0/P1/P2 (all optional; defaults shown) ────────────────────────
BACKUP_ENABLED=true
BACKUP_DIR=data/backups
BACKUP_KEEP=8
RECONCILIATION_MAX_LOOKBACK_DAYS=30
MANUAL_CANCEL_INFERENCE_HOURS=24
SENTIMENT_CANARY_MAX_AGE_DAYS=7
TARGET_EDIT_WARN_THRESHOLD_PCT=10
FUNDS_DETECTION_THRESHOLD_USD=500
