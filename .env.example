# ── Broker ────────────────────────────────────────────────────────────────────
# Options: alpaca_paper | alpaca_live | moomoo (moomoo not yet implemented)
BROKER=alpaca_paper

# Required when BROKER starts with "alpaca".
# Generate at https://app.alpaca.markets → Settings → API Keys
ALPACA_API_KEY=replace-me
ALPACA_SECRET_KEY=replace-me

# ── Storage ───────────────────────────────────────────────────────────────────
SQLITE_PATH=./data/investor.db
TARGETS_PATH=./config/targets.yaml

# ── Operational ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
TZ=America/New_York

# ── Phase 2+ ──────────────────────────────────────────────────────────────────
# Admin token protects /admin/* endpoints.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=
ANTHROPIC_API_KEY=        # from console.anthropic.com
MAGIC_LINK_SECRET=        # openssl rand -hex 32  (distinct from ADMIN_TOKEN)
APP_BASE_URL=http://localhost:8000
FINNHUB_API_KEY=        # from https://finnhub.io (free tier, 60 req/min)

# ── Phase 1+ (leave empty for Phase 0) ───────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
