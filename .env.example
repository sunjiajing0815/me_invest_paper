# ── Broker ────────────────────────────────────────────────────────────────────
# Options: alpaca_paper | alpaca_live | moomoo
BROKER=alpaca_paper

# Required when BROKER starts with "alpaca".
# Generate at https://app.alpaca.markets → Settings → API Keys
ALPACA_API_KEY=replace-me
ALPACA_SECRET_KEY=replace-me

# ── Storage ───────────────────────────────────────────────────────────────────
SQLITE_PATH=./data/investor.db
TARGETS_PATH=./config/targets.yaml

# ── Operational ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
TZ=America/New_York

# ── Phase 2+ ──────────────────────────────────────────────────────────────────
# Admin token protects /admin/* endpoints.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=
ANTHROPIC_API_KEY=        # from console.anthropic.com
MAGIC_LINK_SECRET=        # openssl rand -hex 32  (distinct from ADMIN_TOKEN)
APP_BASE_URL=http://localhost:8000
FINNHUB_API_KEY=        # from https://finnhub.io (free tier, 60 req/min)

# ── Phase 1+ (leave empty for Phase 0) ───────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
LLM_BACKEND=        # agent_sdk | anthropic_api (default)

# ── Phase 4 — Moomoo/Futu OpenD (leave empty unless using Moomoo) ─────────────
# Set BROKER=moomoo to make Moomoo the primary broker.
# Set OPEND_HOST to run OpenD in parallel alongside Alpaca (data sync only).
OPEND_HOST=          # e.g. host.docker.internal  (empty = Moomoo unavailable)
OPEND_PORT=11111
OPEND_SECURITY_FIRM=FUTUSECURITIES
AUTO_TRADE_PROMOTION_TOKEN=   # openssl rand -hex 32  (separate from ADMIN_TOKEN)

# ── Phase 4.5 — Tavily weekly market context (leave empty to skip section) ─────
TAVILY_API_KEY=       # from https://tavily.com (free tier: 1 000 searches/month)
TAVILY_MONTHLY_CAP=200
