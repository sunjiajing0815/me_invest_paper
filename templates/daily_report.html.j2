{%- import '_components.html.j2' as ui -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Portfolio — {{ report.date.strftime('%Y-%m-%d') }}</title>
{{ ui.responsive_style() }}
</head>
<body class="eb-body" style="font-family:Arial,Helvetica,sans-serif; color:{{ ui.BODY }}; background:#ffffff; max-width:700px; margin:0 auto; padding:16px; -webkit-text-size-adjust:100%;">
{{ ui.preheader("Portfolio snapshot for " ~ report.date.strftime('%b %-d') ~ (" · equity $%s"|format("{:,.0f}".format(report.account.equity_usd)) if report.account else "")) }}

{{ ui.header("Portfolio Report",
             subtitle=report.date.strftime('%A, %B %-d, %Y'),
             nickname=account_nickname, broker=account_broker,
             account=report.account) }}

{# ---- Drift alerts ---- #}
{% if report.drift_alerts %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:{{ ui.WARN_BG }}; border:1px solid {{ ui.WARN_BORDER }}; border-radius:8px; margin:0 0 20px 0;">
  <tr><td style="padding:12px 16px;">
    <strong style="font-family:Arial,Helvetica,sans-serif; font-size:13px; color:{{ ui.WARN }};">&#9888; Drift alert &mdash; {{ report.drift_alerts|length }} ticker(s) outside band</strong>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:8px; font-family:Arial,Helvetica,sans-serif; font-size:13px;">
      {% for r in report.drift_alerts %}
      <tr><td style="padding:2px 0; color:{{ ui.WARN }};">
        <strong>{{ r.ticker }}</strong> &mdash; {{ r.band_status | upper }}
        ({{ "{:+.1f}".format(r.gap_pct) }}% / ${{ "{:+,.0f}".format(r.gap_usd) }})
      </td></tr>
      {% endfor %}
    </table>
  </td></tr>
</table>
{% endif %}

{# ---- Untracked positions ---- #}
{{ ui.untracked_box(report.untracked_positions) }}

{# ---- Allocation ---- #}
{{ ui.section("Allocation") }}
<div class="sscroll" style="overflow-x:auto; -webkit-overflow-scrolling:touch;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse; font-family:Arial,Helvetica,sans-serif; font-size:13px; margin:0 0 24px 0;">
  <thead>
    <tr style="background:{{ ui.HEADBG }}; color:{{ ui.MUTED }};">
      <th style="padding:8px 10px; text-align:left; border-bottom:2px solid {{ ui.LINE2 }};">Ticker</th>
      <th style="padding:8px 10px; text-align:right; border-bottom:2px solid {{ ui.LINE2 }};">Qty</th>
      <th style="padding:8px 10px; text-align:right; border-bottom:2px solid {{ ui.LINE2 }};">Avg Cost</th>
      <th style="padding:8px 10px; text-align:right; border-bottom:2px solid {{ ui.LINE2 }};">Market Value</th>
      <th style="padding:8px 10px; text-align:right; border-bottom:2px solid {{ ui.LINE2 }};">Current %</th>
      <th style="padding:8px 10px; text-align:right; border-bottom:2px solid {{ ui.LINE2 }};">Target %</th>
      <th style="padding:8px 10px; text-align:right; border-bottom:2px solid {{ ui.LINE2 }};">Gap %</th>
      <th style="padding:8px 10px; text-align:center; border-bottom:2px solid {{ ui.LINE2 }};">Band</th>
    </tr>
  </thead>
  <tbody>
    {% set gap_by_ticker = {} %}
    {% for g in report.gap_rows %}{% if gap_by_ticker.update({g.ticker: g}) %}{% endif %}{% endfor %}
    {% for pos in report.positions %}
    {% set gap = gap_by_ticker.get(pos.ticker) %}
    {% set bg = '#fdf5f4' if gap and gap.band_status != 'in_band' else '#ffffff' %}
    <tr style="border-bottom:1px solid {{ ui.LINE }}; background:{{ bg }}; color:{{ ui.BODY }};">
      <td style="padding:7px 10px; font-weight:bold;">{{ pos.ticker }}</td>
      <td style="padding:7px 10px; text-align:right;">{{ "{:.2f}".format(pos.qty) }}</td>
      <td style="padding:7px 10px; text-align:right;">${{ "{:,.2f}".format(pos.avg_cost) }}</td>
      <td style="padding:7px 10px; text-align:right;">${{ "{:,.0f}".format(pos.market_value) }} {{ pos.currency }}</td>
      <td style="padding:7px 10px; text-align:right;">{{ "{:.1f}".format(pos.weight_pct) }}%</td>
      <td style="padding:7px 10px; text-align:right;">{{ "{:.1f}".format(gap.target_pct) if gap else '—' }}%</td>
      <td style="padding:7px 10px; text-align:right; color:{{ ui.NEG if gap and gap.gap_pct < 0 else ui.POS }};">{{ "{:+.1f}".format(gap.gap_pct) if gap else '—' }}%</td>
      <td style="padding:7px 10px; text-align:center;">
        {% if gap %}{% if gap.band_status == 'in_band' %}<span style="color:{{ ui.POS }};">&#10003;</span>{% elif gap.band_status == 'under' %}<span style="color:{{ ui.WARN }};">under</span>{% else %}<span style="color:{{ ui.NEG }};">over</span>{% endif %}{% else %}&mdash;{% endif %}
      </td>
    </tr>
    {% else %}
    <tr><td colspan="8" style="padding:16px 10px; text-align:center; color:{{ ui.MUTED }};">No positions</td></tr>
    {% endfor %}
  </tbody>
</table>
</div>

{# ---- Gap summary ---- #}
{% if report.gap_rows %}
{{ ui.section("Gap Summary") }}
{% set underweight = report.gap_rows | selectattr('gap_pct', '>', 0) | list | sort(attribute='gap_pct', reverse=True) %}
{% set overweight  = report.gap_rows | selectattr('gap_pct', '<', 0) | list | sort(attribute='gap_pct') %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-family:Arial,Helvetica,sans-serif; font-size:13px; margin:0 0 24px 0;">
  <tr>
    <td class="card-col" width="50%" style="padding-right:8px; vertical-align:top;">
      <strong style="font-size:12px; color:{{ ui.POS }};">&#9650; Top underweight (buy)</strong>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:6px; font-size:12px;">
        {% for r in underweight[:3] %}
        <tr><td style="padding:2px 0; color:{{ ui.BODY }};">{{ r.ticker }}: {{ "{:+.1f}".format(r.gap_pct) }}% (${{ "{:,.0f}".format(r.gap_usd) }})</td></tr>
        {% else %}
        <tr><td style="padding:2px 0; color:{{ ui.MUTED }};">None</td></tr>
        {% endfor %}
      </table>
    </td>
    <td class="card-col" width="50%" style="padding-left:8px; vertical-align:top;">
      <strong style="font-size:12px; color:{{ ui.NEG }};">&#9660; Top overweight (trim)</strong>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:6px; font-size:12px;">
        {% for r in overweight[:3] %}
        <tr><td style="padding:2px 0; color:{{ ui.BODY }};">{{ r.ticker }}: {{ "{:+.1f}".format(r.gap_pct) }}% (${{ "{:,.0f}".format(r.gap_usd) }})</td></tr>
        {% else %}
        <tr><td style="padding:2px 0; color:{{ ui.MUTED }};">None</td></tr>
        {% endfor %}
      </table>
    </td>
  </tr>
</table>
{% endif %}

{# ---- Levels at a glance ---- #}
{% if report.indicators %}
{{ ui.section("Levels at a Glance") }}
{{ ui.levels_table(report.indicators, report.nearby_levels, etf_tickers if etf_tickers is defined else None) }}
{% endif %}

{{ ui.footer("No orders are placed automatically. All execution is manual, in the broker's UI.",
             report.date.strftime('%Y-%m-%d')) }}

</body>
</html>
