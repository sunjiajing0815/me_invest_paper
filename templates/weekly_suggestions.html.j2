{%- import '_components.html.j2' as ui -%}
{%- import '_sentiment.html.j2' as sentiment -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Orders for the week of {{ week_of.strftime('%b %-d') }}</title>
{{ ui.responsive_style() }}
</head>
<body class="eb-body" style="font-family:Arial,Helvetica,sans-serif; color:{{ ui.BODY }}; background:#ffffff; max-width:700px; margin:0 auto; padding:16px; -webkit-text-size-adjust:100%;">
{{ ui.preheader("Suggested orders for the week of " ~ week_of.strftime('%b %-d') ~ " — review and act manually.") }}

{{ ui.header("Orders for the week of " ~ week_of.strftime('%b %-d'),
             subtitle="Suggestions expire Friday at close. Log into " ~ (account_broker | capitalize) ~ " to act.",
             nickname=account_nickname, broker=account_broker, account=account) }}

{{ sentiment.sentiment_box(market_context if market_context is defined else None) }}

{{ ui.earnings_box(earnings_warnings if earnings_warnings is defined else None) }}

{{ ui.untracked_box(untracked) }}

{# ---- Suggested orders ---- #}
{{ ui.section("Suggested Orders") }}
{% if suggestion_items %}
{% set total_buy_usd = namespace(v=0) %}
{% set total_sell_usd = namespace(v=0) %}
{% set buy_count = namespace(n=0) %}
{% set sell_count = namespace(n=0) %}
<div class="sscroll" style="overflow-x:auto; -webkit-overflow-scrolling:touch;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse; font-family:Arial,Helvetica,sans-serif; font-size:13px; margin:0 0 16px 0;">
  <thead>
    <tr style="background:{{ ui.HEADBG }}; color:{{ ui.MUTED }};">
      <th style="padding:8px 10px; text-align:left; border-bottom:2px solid {{ ui.LINE2 }};">Ticker</th>
      <th style="padding:8px 10px; text-align:center; border-bottom:2px solid {{ ui.LINE2 }};">Side</th>
      <th style="padding:8px 10px; text-align:right; border-bottom:2px solid {{ ui.LINE2 }};">Qty</th>
      <th style="padding:8px 10px; text-align:right; border-bottom:2px solid {{ ui.LINE2 }};">Limit</th>
      <th style="padding:8px 10px; text-align:right; border-bottom:2px solid {{ ui.LINE2 }};">Current</th>
      <th style="padding:8px 10px; text-align:right; border-bottom:2px solid {{ ui.LINE2 }};">~$</th>
      <th style="padding:8px 10px; text-align:left; border-bottom:2px solid {{ ui.LINE2 }};">Actions</th>
    </tr>
  </thead>
  <tbody>
    {% for item in suggestion_items %}
    {% set s = item.suggestion %}
    {% set ind = indicators | selectattr('ticker', 'equalto', s.ticker) | first | default(None) %}
    {% set current = ind.close if ind else 0 %}
    {% set nb = nearby.get(s.ticker) if nearby is defined else None %}
    {% set cost = s.qty * s.limit_price %}
    {% if s.side == 'buy' %}{% set total_buy_usd.v = total_buy_usd.v + cost %}{% set buy_count.n = buy_count.n + 1 %}{% endif %}
    {% if s.side == 'sell' %}{% set total_sell_usd.v = total_sell_usd.v + cost %}{% set sell_count.n = sell_count.n + 1 %}{% endif %}
    {% set row_bg = '#f1faf3' if s.side == 'buy' else '#fdf5f4' %}
    <tr style="background:{{ row_bg }}; color:{{ ui.BODY }};">
      <td style="padding:8px 10px 3px 10px; font-weight:bold;">{{ s.ticker }}</td>
      <td style="padding:8px 10px 3px 10px; text-align:center;">
        {% if s.side == 'buy' %}<span style="background:{{ ui.POS }}; color:#fff; padding:2px 8px; border-radius:4px; font-size:11px; font-weight:bold;">BUY</span>
        {% else %}<span style="background:{{ ui.NEG }}; color:#fff; padding:2px 8px; border-radius:4px; font-size:11px; font-weight:bold;">TRIM</span>{% endif %}
      </td>
      <td style="padding:8px 10px 3px 10px; text-align:right;">
        {{ "{:.0f}".format(s.qty) }}
        {% if s.size_factor is defined and s.size_factor != 1.0 and s.base_qty is defined and s.base_qty is not none %}
        <span style="color:{{ ui.MUTED }}; font-size:11px;">(base&nbsp;{{ "{:.0f}".format(s.base_qty) }}&nbsp;&middot;&nbsp;&times;{{ "%.2f"|format(s.size_factor) }})</span>
        {% endif %}
      </td>
      <td style="padding:8px 10px 3px 10px; text-align:right;">${{ "{:,.2f}".format(s.limit_price) }}</td>
      <td style="padding:8px 10px 3px 10px; text-align:right;">{{ ui.price_range(current, nb.current if nb else None) if current else '—' }}</td>
      <td style="padding:8px 10px 3px 10px; text-align:right;">${{ "{:,.0f}".format(cost) }}</td>
      <td style="padding:8px 10px 3px 10px; white-space:nowrap;">
        <a href="{{ base_url }}/suggestions/{{ item.sid }}/accept?token={{ item.accept_token }}" style="background:{{ ui.POS }}; color:#ffffff; padding:5px 11px; text-decoration:none; border-radius:4px; font-size:11px; font-weight:bold; margin-right:4px;">Accept</a>
        <a href="{{ base_url }}/suggestions/{{ item.sid }}/reject?token={{ item.reject_token }}" style="background:{{ ui.MUTED }}; color:#ffffff; padding:5px 11px; text-decoration:none; border-radius:4px; font-size:11px;">Reject</a>
      </td>
    </tr>
    <tr style="background:{{ row_bg }}; border-bottom:2px solid {{ ui.LINE2 }};">
      <td colspan="7" style="padding:2px 10px 8px 10px; font-size:12px; color:{{ ui.MUTED }};">
        {{ item.rationale if item.rationale else s.reason }}
        {% if s.context_note is defined and s.context_note %}<span style="color:{{ ui.MUTED }};"> &middot; {{ s.context_note }}</span>{% endif %}
      </td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:{{ ui.ROWALT }}; border:1px solid {{ ui.LINE }}; border-radius:8px; margin:0 0 20px 0;">
  <tr><td style="padding:12px 16px; font-family:Arial,Helvetica,sans-serif; font-size:13px; color:{{ ui.BODY }};">
    <strong style="color:{{ ui.POS }};">{{ buy_count.n }} buy{{ 's' if buy_count.n != 1 else '' }}</strong> &mdash; deploy ${{ "{:,.0f}".format(total_buy_usd.v) }}
    &nbsp;&nbsp;|&nbsp;&nbsp;
    <strong style="color:{{ ui.NEG }};">{{ sell_count.n }} trim{{ 's' if sell_count.n != 1 else '' }}</strong> &mdash; raise ${{ "{:,.0f}".format(total_sell_usd.v) }}
  </td></tr>
</table>
{% else %}
<p style="padding:16px; background:{{ ui.ROWALT }}; border:1px solid {{ ui.LINE }}; border-radius:8px; color:{{ ui.MUTED }}; font-size:13px;">
  No suggestions this week — all positions are within their rebalance bands, or no S/R level is close enough to act on.
</p>
{% endif %}

{# ---- Top-up opportunities (plans/pre_phase5_features_design.md) ---- #}
{% if topup_items is defined and topup_items %}
{{ ui.section("Top-Up Opportunities") }}
<p style="font-family:Arial,Helvetica,sans-serif; font-size:12px; color:{{ ui.MUTED }}; margin:0 0 8px 0;">
  Near-target tickers &mdash; qty fills the remaining gap to target, scaled by market
  sentiment, and never crosses the band.
  <span style="color:{{ ui.POS }}; font-weight:bold;">&#9733; Strong entry</span> = high-confidence level and no bearish news this week.
</p>
<div class="sscroll" style="overflow-x:auto; -webkit-overflow-scrolling:touch;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse; font-family:Arial,Helvetica,sans-serif; font-size:13px; margin:0 0 20px 0;">
  <thead>
    <tr style="background:{{ ui.HEADBG }}; color:{{ ui.MUTED }};">
      <th style="padding:8px 10px; text-align:left; border-bottom:2px solid {{ ui.LINE2 }};">Ticker</th>
      <th style="padding:8px 10px; text-align:right; border-bottom:2px solid {{ ui.LINE2 }};">Qty</th>
      <th style="padding:8px 10px; text-align:right; border-bottom:2px solid {{ ui.LINE2 }};">Limit</th>
      <th style="padding:8px 10px; text-align:right; border-bottom:2px solid {{ ui.LINE2 }};">Current</th>
      <th style="padding:8px 10px; text-align:right; border-bottom:2px solid {{ ui.LINE2 }};">~$</th>
      <th style="padding:8px 10px; text-align:left; border-bottom:2px solid {{ ui.LINE2 }};">Actions</th>
    </tr>
  </thead>
  <tbody>
    {% for item in topup_items %}
    {% set s = item.suggestion %}
    {% set ind = indicators | selectattr('ticker', 'equalto', s.ticker) | first | default(None) %}
    {% set current = ind.close if ind else 0 %}
    {% set nb = nearby.get(s.ticker) if nearby is defined else None %}
    {% set cost = s.qty * s.limit_price %}
    {% set hl = s.is_highlighted is defined and s.is_highlighted %}
    {% set row_bg = ui.HL_BG if hl else ui.ROWALT %}
    <tr style="background:{{ row_bg }}; color:{{ ui.BODY }};{% if hl %} border-left:3px solid {{ ui.HL_BORDER }};{% endif %}">
      <td style="padding:8px 10px 3px 10px; font-weight:bold;">
        {{ s.ticker }}
        {% if hl %}<span style="background:{{ ui.POS }}; color:#ffffff; padding:2px 8px; border-radius:10px; font-size:10px; font-weight:bold; margin-left:6px; white-space:nowrap;">&#9733; STRONG ENTRY</span>{% endif %}
      </td>
      <td style="padding:8px 10px 3px 10px; text-align:right;">
        {{ "{:.0f}".format(s.qty) }}
        {% if s.size_factor is defined and s.base_qty is defined and s.base_qty is not none %}
        <span style="color:{{ ui.MUTED }}; font-size:11px;">(base&nbsp;{{ "{:.0f}".format(s.base_qty) }}&nbsp;&middot;&nbsp;&times;{{ "%.2f"|format(s.size_factor) }})</span>
        {% endif %}
      </td>
      <td style="padding:8px 10px 3px 10px; text-align:right;">${{ "{:,.2f}".format(s.limit_price) }}</td>
      <td style="padding:8px 10px 3px 10px; text-align:right;">{{ ui.price_range(current, nb.current if nb else None) if current else '—' }}</td>
      <td style="padding:8px 10px 3px 10px; text-align:right;">${{ "{:,.0f}".format(cost) }}</td>
      <td style="padding:8px 10px 3px 10px; white-space:nowrap;">
        <a href="{{ base_url }}/suggestions/{{ item.sid }}/accept?token={{ item.accept_token }}" style="background:{{ ui.POS }}; color:#ffffff; padding:5px 11px; text-decoration:none; border-radius:4px; font-size:11px; font-weight:bold; margin-right:4px;">Accept</a>
        <a href="{{ base_url }}/suggestions/{{ item.sid }}/reject?token={{ item.reject_token }}" style="background:{{ ui.MUTED }}; color:#ffffff; padding:5px 11px; text-decoration:none; border-radius:4px; font-size:11px;">Reject</a>
      </td>
    </tr>
    <tr style="background:{{ row_bg }}; border-bottom:2px solid {{ ui.LINE2 }};{% if hl %} border-left:3px solid {{ ui.HL_BORDER }};{% endif %}">
      <td colspan="6" style="padding:2px 10px 8px 10px; font-size:12px; color:{{ ui.MUTED }};">
        {{ item.rationale if item.rationale else s.reason }}
        {% if s.context_note is defined and s.context_note %}<span> &middot; {{ s.context_note }}</span>{% endif %}
      </td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>
{% endif %}

{# ---- Not suggested ---- #}
{% if skipped %}
{{ ui.section("Not Suggested This Week") }}
<p style="font-family:Arial,Helvetica,sans-serif; font-size:12px; color:{{ ui.MUTED }}; margin:0 0 8px 0;">Out-of-band tickers considered but no actionable level found:</p>
<div class="sscroll" style="overflow-x:auto; -webkit-overflow-scrolling:touch;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse; font-family:Arial,Helvetica,sans-serif; font-size:12px; margin:0 0 20px 0;">
  <thead>
    <tr style="background:{{ ui.HEADBG }}; color:{{ ui.MUTED }};">
      <th style="padding:6px 10px; text-align:left; border-bottom:2px solid {{ ui.LINE2 }};">Ticker</th>
      <th style="padding:6px 10px; text-align:center; border-bottom:2px solid {{ ui.LINE2 }};">Side</th>
      <th style="padding:6px 10px; text-align:right; border-bottom:2px solid {{ ui.LINE2 }};">Gap</th>
      <th style="padding:6px 10px; text-align:left; border-bottom:2px solid {{ ui.LINE2 }};">Why skipped</th>
    </tr>
  </thead>
  <tbody>
    {% for sk in skipped %}
    <tr style="border-bottom:1px solid {{ ui.LINE }}; color:{{ ui.BODY }};">
      <td style="padding:6px 10px; font-weight:bold;">{{ sk.ticker }}</td>
      <td style="padding:6px 10px; text-align:center; color:{{ ui.MUTED }};">{{ 'buy' if sk.side == 'buy' else 'trim' }}</td>
      <td style="padding:6px 10px; text-align:right; color:{{ ui.POS if sk.gap_pct > 0 else ui.NEG }};">{{ "{:+.1f}%".format(sk.gap_pct) }}</td>
      <td style="padding:6px 10px; color:{{ ui.MUTED }}; font-size:11px;">{{ sk.reason }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>
{% endif %}

{# ---- Levels at a glance ---- #}
{% if indicators %}
{{ ui.section("Levels at a Glance") }}
{{ ui.levels_table(indicators, nearby, etf_tickers if etf_tickers is defined else None) }}
{% if scoring_failures %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-family:Arial,Helvetica,sans-serif; font-size:11px; margin:0 0 16px 0;">
  {% for f in scoring_failures %}
  <tr><td style="padding:3px 10px; color:{{ ui.WARN }};">{{ f.ticker }}: scoring failed ({{ f.exc_type }}) — using nearest-distance fallback.</td></tr>
  {% endfor %}
</table>
{% endif %}
{% endif %}

{{ ui.holdings_glossary(ticker_names if ticker_names is defined else {}) }}

{{ ui.footer("No orders are placed automatically. Log into " ~ (account_broker | capitalize) ~ " to act on any suggestion. Suggestions expire Friday at close.",
             week_of.strftime('%Y-%m-%d')) }}

</body>
</html>
