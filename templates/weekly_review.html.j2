{%- import '_components.html.j2' as ui -%}
{%- import '_sentiment.html.j2' as sentiment -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Weekly Review: {{ review.week_of.strftime('%b %-d, %Y') }}</title>
{{ ui.responsive_style() }}
</head>
<body class="eb-body" style="font-family:Arial,Helvetica,sans-serif; color:{{ ui.BODY }}; background:#ffffff; max-width:700px; margin:0 auto; padding:16px; -webkit-text-size-adjust:100%;">
{{ ui.preheader("Weekly review for the week of " ~ review.week_of.strftime('%b %-d') ~ " — realized PnL, drift, and next week's preview.") }}

{{ ui.header("Weekly Review", subtitle="Week of " ~ review.week_of.strftime('%B %-d, %Y'), account=review.account) }}

{% set pnl_color = ui.POS if review.realized_pnl_usd >= 0 else ui.NEG %}
<p style="font-family:Arial,Helvetica,sans-serif; font-size:14px; margin:0 0 20px 2px; color:{{ ui.BODY }};">
  Realized PnL this week: <strong style="color:{{ pnl_color }};">{{ "+" if review.realized_pnl_usd >= 0 else "" }}${{ "{:,.2f}".format(review.realized_pnl_usd) }}</strong>
</p>

{{ sentiment.sentiment_box(review.market_context) }}

{# ---- Suggestions vs fills ---- #}
{{ ui.section("Suggestions vs Fills") }}
{% if review.suggestion_audits %}
<div class="sscroll" style="overflow-x:auto; -webkit-overflow-scrolling:touch;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse; font-family:Arial,Helvetica,sans-serif; font-size:13px; margin:0 0 20px 0;">
  <thead>
    <tr style="background:{{ ui.HEADBG }}; color:{{ ui.MUTED }};">
      <th style="padding:8px 10px; text-align:left; border-bottom:2px solid {{ ui.LINE2 }};">Ticker</th>
      <th style="padding:8px 10px; text-align:center; border-bottom:2px solid {{ ui.LINE2 }};">Side</th>
      <th style="padding:8px 10px; text-align:right; border-bottom:2px solid {{ ui.LINE2 }};">Qty</th>
      <th style="padding:8px 10px; text-align:right; border-bottom:2px solid {{ ui.LINE2 }};">Limit</th>
      <th style="padding:8px 10px; text-align:center; border-bottom:2px solid {{ ui.LINE2 }};">Status</th>
      <th style="padding:8px 10px; text-align:right; border-bottom:2px solid {{ ui.LINE2 }};">Fill Price</th>
      <th style="padding:8px 10px; text-align:left; border-bottom:2px solid {{ ui.LINE2 }};">Acted At</th>
    </tr>
  </thead>
  <tbody>
    {% for a in review.suggestion_audits %}
    {% if a.status == 'accepted' %}{% set row_bg = '#f1faf3' %}
    {% elif a.status == 'rejected' %}{% set row_bg = '#fdf5f4' %}
    {% elif a.status in ('expired', 'cancelled') %}{% set row_bg = ui.ROWALT %}
    {% else %}{% set row_bg = '#fffdf0' %}{% endif %}
    {% if a.status in ('accepted', 'filled') %}{% set status_color = ui.POS %}
    {% elif a.status == 'rejected' %}{% set status_color = ui.NEG %}
    {% elif a.status in ('expired', 'cancelled') %}{% set status_color = ui.MUTED %}
    {% else %}{% set status_color = ui.WARN %}{% endif %}
    <tr style="border-bottom:1px solid {{ ui.LINE }}; background:{{ row_bg }}; color:{{ ui.BODY }};">
      <td style="padding:7px 10px; font-weight:bold;">{{ a.ticker }}</td>
      <td style="padding:7px 10px; text-align:center;">
        {% if a.side == 'buy' %}<span style="background:{{ ui.POS }}; color:#fff; padding:2px 8px; border-radius:4px; font-size:11px; font-weight:bold;">BUY</span>
        {% else %}<span style="background:{{ ui.NEG }}; color:#fff; padding:2px 8px; border-radius:4px; font-size:11px; font-weight:bold;">TRIM</span>{% endif %}
      </td>
      <td style="padding:7px 10px; text-align:right;">{{ "{:.0f}".format(a.qty) }}</td>
      <td style="padding:7px 10px; text-align:right;">${{ "{:,.2f}".format(a.limit_price) }}</td>
      <td style="padding:7px 10px; text-align:center; color:{{ status_color }}; font-weight:bold; font-size:11px; text-transform:uppercase;">{{ a.status }}</td>
      <td style="padding:7px 10px; text-align:right;">{{ "$" + "{:,.2f}".format(a.filled_price) if a.filled_price else '—' }}</td>
      <td style="padding:7px 10px; font-size:11px; color:{{ ui.MUTED }};">{{ a.acted_at.strftime('%b %-d %H:%M') if a.acted_at else '—' }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>
{% else %}
<p style="padding:16px; background:{{ ui.ROWALT }}; border:1px solid {{ ui.LINE }}; border-radius:8px; color:{{ ui.MUTED }}; font-size:13px; margin:0 0 20px 0;">No suggestions were generated for this week.</p>
{% endif %}

{# ---- Drift state ---- #}
{{ ui.section("Drift State") }}
{% if review.gap_rows %}
<div class="sscroll" style="overflow-x:auto; -webkit-overflow-scrolling:touch;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse; font-family:Arial,Helvetica,sans-serif; font-size:13px; margin:0 0 20px 0;">
  <thead>
    <tr style="background:{{ ui.HEADBG }}; color:{{ ui.MUTED }};">
      <th style="padding:7px 10px; text-align:left; border-bottom:2px solid {{ ui.LINE2 }};">Ticker</th>
      <th style="padding:7px 10px; text-align:right; border-bottom:2px solid {{ ui.LINE2 }};">Current %</th>
      <th style="padding:7px 10px; text-align:right; border-bottom:2px solid {{ ui.LINE2 }};">Target %</th>
      <th style="padding:7px 10px; text-align:right; border-bottom:2px solid {{ ui.LINE2 }};">Gap %</th>
      <th style="padding:7px 10px; text-align:right; border-bottom:2px solid {{ ui.LINE2 }};">Gap $</th>
      <th style="padding:7px 10px; text-align:center; border-bottom:2px solid {{ ui.LINE2 }};">Band</th>
    </tr>
  </thead>
  <tbody>
    {% for g in review.gap_rows %}
    {% set row_bg = ui.WARN_BG if g.band_status != 'in_band' else '#ffffff' %}
    {% set gap_color = ui.POS if g.gap_pct > 0 else ui.NEG %}
    <tr style="border-bottom:1px solid {{ ui.LINE }}; background:{{ row_bg }}; color:{{ ui.BODY }};">
      <td style="padding:6px 10px; font-weight:bold;">{{ g.ticker }}</td>
      <td style="padding:6px 10px; text-align:right;">{{ "{:.1f}%".format(g.current_pct) }}</td>
      <td style="padding:6px 10px; text-align:right;">{{ "{:.1f}%".format(g.target_pct) }}</td>
      <td style="padding:6px 10px; text-align:right; color:{{ gap_color }};">{{ "{:+.1f}%".format(g.gap_pct) }}</td>
      <td style="padding:6px 10px; text-align:right; color:{{ gap_color }};">${{ "{:+,.0f}".format(g.gap_usd) }}</td>
      <td style="padding:6px 10px; text-align:center; font-size:11px; text-transform:uppercase; color:{{ ui.WARN if g.band_status != 'in_band' else ui.POS }};">{{ g.band_status }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>
{% else %}
<p style="padding:16px; background:{{ ui.ROWALT }}; border:1px solid {{ ui.LINE }}; border-radius:8px; color:{{ ui.MUTED }}; font-size:13px; margin:0 0 20px 0;">No gap data available.</p>
{% endif %}

{# ---- Material news ---- #}
{{ ui.section("Material News This Week") }}
{% if review.material_news %}
{% for ticker, news_items in review.material_news.items() %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse; margin:0 0 12px 0; border:1px solid {{ ui.LINE }}; border-radius:8px; overflow:hidden;">
  <tr style="background:{{ ui.HEADBG }};">
    <td style="padding:8px 12px; font-weight:bold; font-size:13px; color:{{ ui.INK }};">{{ ticker }}</td>
  </tr>
  {% for item in news_items %}
  {% set sent_color = ui.POS if item.sentiment == 'bullish' else (ui.NEG if item.sentiment == 'bearish' else ui.MUTED) %}
  <tr style="border-top:1px solid {{ ui.LINE }};">
    <td style="padding:8px 12px; font-size:12px; color:{{ ui.BODY }};">
      <span style="color:{{ sent_color }}; font-weight:bold; text-transform:uppercase; font-size:10px; margin-right:8px;">{{ item.sentiment or 'neutral' }}</span>
      {{ item.summary or '(no summary)' }}
    </td>
  </tr>
  {% endfor %}
</table>
{% endfor %}
{% else %}
<p style="padding:16px; background:{{ ui.ROWALT }}; border:1px solid {{ ui.LINE }}; border-radius:8px; color:{{ ui.MUTED }}; font-size:13px; margin:0 0 20px 0;">No material news this week.</p>
{% endif %}

{# ---- Preview: next week's suggestions ---- #}
{{ ui.section("Preview: Next Week's Suggestions") }}
{% if review.preview_suggestions %}
<div class="sscroll" style="overflow-x:auto; -webkit-overflow-scrolling:touch;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse; font-family:Arial,Helvetica,sans-serif; font-size:13px; margin:0 0 20px 0;">
  <thead>
    <tr style="background:{{ ui.HEADBG }}; color:{{ ui.MUTED }};">
      <th style="padding:7px 10px; text-align:left; border-bottom:2px solid {{ ui.LINE2 }};">Ticker</th>
      <th style="padding:7px 10px; text-align:center; border-bottom:2px solid {{ ui.LINE2 }};">Side</th>
      <th style="padding:7px 10px; text-align:right; border-bottom:2px solid {{ ui.LINE2 }};">Qty</th>
      <th style="padding:7px 10px; text-align:right; border-bottom:2px solid {{ ui.LINE2 }};">Limit</th>
      <th style="padding:7px 10px; text-align:right; border-bottom:2px solid {{ ui.LINE2 }};">~$</th>
      <th style="padding:7px 10px; text-align:left; border-bottom:2px solid {{ ui.LINE2 }};">Reason</th>
    </tr>
  </thead>
  <tbody>
    {% for p in review.preview_suggestions %}
    {% set cost = p.qty * p.limit_price %}
    {% set row_bg = '#f1faf3' if p.side == 'buy' else '#fdf5f4' %}
    <tr style="border-bottom:1px solid {{ ui.LINE }}; background:{{ row_bg }}; color:{{ ui.BODY }};">
      <td style="padding:6px 10px; font-weight:bold;">{{ p.ticker }}</td>
      <td style="padding:6px 10px; text-align:center;">
        {% if p.side == 'buy' %}<span style="background:{{ ui.POS }}; color:#fff; padding:2px 8px; border-radius:4px; font-size:11px; font-weight:bold;">BUY</span>
        {% else %}<span style="background:{{ ui.NEG }}; color:#fff; padding:2px 8px; border-radius:4px; font-size:11px; font-weight:bold;">TRIM</span>{% endif %}
      </td>
      <td style="padding:6px 10px; text-align:right;">{{ "{:.0f}".format(p.qty) }}</td>
      <td style="padding:6px 10px; text-align:right;">${{ "{:,.2f}".format(p.limit_price) }}</td>
      <td style="padding:6px 10px; text-align:right;">${{ "{:,.0f}".format(cost) }}</td>
      <td style="padding:6px 10px; font-size:12px; color:{{ ui.MUTED }};">{{ p.reason }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>
{% else %}
<p style="padding:16px; background:{{ ui.ROWALT }}; border:1px solid {{ ui.LINE }}; border-radius:8px; color:{{ ui.MUTED }}; font-size:13px; margin:0 0 20px 0;">No preview suggestions available.</p>
{% endif %}

{# ---- Auto-trade activity ---- #}
{{ ui.section("Auto-Trade Activity") }}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:{{ ui.ROWALT }}; border:1px solid {{ ui.LINE }}; border-radius:8px; margin:0 0 12px 0;">
  <tr><td style="padding:12px 16px; font-family:Arial,Helvetica,sans-serif; font-size:13px; color:{{ ui.BODY }};">
    Mode: <strong>{{ review.auto_trade_mode }}</strong> &nbsp;&nbsp;|&nbsp;&nbsp; Executions this week: <strong>{{ review.executions_this_week }}</strong>
  </td></tr>
</table>
{% if review.promotions_this_week %}
<p style="font-family:Arial,Helvetica,sans-serif; font-size:12px; color:{{ ui.MUTED }}; margin:0 0 4px 0;"><strong>Mode changes:</strong></p>
<div class="sscroll" style="overflow-x:auto; -webkit-overflow-scrolling:touch;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse; font-family:Arial,Helvetica,sans-serif; font-size:12px; margin:0 0 12px 0;">
  <thead>
    <tr style="background:{{ ui.HEADBG }}; color:{{ ui.MUTED }};">
      <th style="padding:5px 10px; text-align:left; border-bottom:1px solid {{ ui.LINE2 }};">Time</th>
      <th style="padding:5px 10px; text-align:left; border-bottom:1px solid {{ ui.LINE2 }};">From</th>
      <th style="padding:5px 10px; text-align:left; border-bottom:1px solid {{ ui.LINE2 }};">To</th>
      <th style="padding:5px 10px; text-align:left; border-bottom:1px solid {{ ui.LINE2 }};">Actor</th>
      <th style="padding:5px 10px; text-align:left; border-bottom:1px solid {{ ui.LINE2 }};">Reason</th>
    </tr>
  </thead>
  <tbody>
    {% for p in review.promotions_this_week %}
    <tr style="border-bottom:1px solid {{ ui.LINE }}; color:{{ ui.BODY }};">
      <td style="padding:5px 10px; color:{{ ui.MUTED }};">{{ p.ts }}</td>
      <td style="padding:5px 10px;">{{ p.from_mode }}</td>
      <td style="padding:5px 10px; font-weight:bold;">{{ p.to_mode }}</td>
      <td style="padding:5px 10px;">{{ p.actor }}</td>
      <td style="padding:5px 10px; color:{{ ui.MUTED }};">{{ p.reason or '—' }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>
{% endif %}
{% if review.kill_switches_this_week %}
<p style="font-family:Arial,Helvetica,sans-serif; font-size:12px; color:{{ ui.NEG }}; margin:0 0 4px 0;"><strong>Kill switches activated:</strong></p>
<div class="sscroll" style="overflow-x:auto; -webkit-overflow-scrolling:touch;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse; font-family:Arial,Helvetica,sans-serif; font-size:12px; margin:0 0 20px 0;">
  <thead>
    <tr style="background:{{ ui.ALERT_BG }}; color:{{ ui.ALERT_INK }};">
      <th style="padding:5px 10px; text-align:left; border-bottom:1px solid {{ ui.ALERT_BORDER }};">Time</th>
      <th style="padding:5px 10px; text-align:left; border-bottom:1px solid {{ ui.ALERT_BORDER }};">Trigger</th>
      <th style="padding:5px 10px; text-align:left; border-bottom:1px solid {{ ui.ALERT_BORDER }};">Detail</th>
    </tr>
  </thead>
  <tbody>
    {% for k in review.kill_switches_this_week %}
    <tr style="border-bottom:1px solid {{ ui.LINE }}; background:#fdf5f4;">
      <td style="padding:5px 10px; color:{{ ui.NEG }};">{{ k.ts }}</td>
      <td style="padding:5px 10px; font-weight:bold; color:{{ ui.NEG }};">{{ k.trigger }}</td>
      <td style="padding:5px 10px; color:{{ ui.MUTED }};">{{ k.detail or '—' }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>
{% else %}
<p style="font-family:Arial,Helvetica,sans-serif; font-size:12px; color:{{ ui.POS }}; margin:0 0 20px 0;">No kill switches activated this week.</p>
{% endif %}

{# ---- Order activity ---- #}
{% if review.order_funnel %}
{{ ui.section("Order Activity — week of " ~ review.order_funnel.week_of.strftime("%b %d")) }}

{{ ui.subsection("Suggestion funnel") }}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse; font-family:Arial,Helvetica,sans-serif; font-size:13px; margin:0 0 12px 0; color:{{ ui.BODY }};">
  <tr><td style="padding:2px 0;">Suggested</td><td style="padding:2px 8px;"><strong>{{ review.order_funnel.suggested }}</strong></td></tr>
  <tr><td style="padding:2px 0;">Accepted</td><td style="padding:2px 8px;"><strong>{{ review.order_funnel.accepted }}</strong></td></tr>
  <tr><td style="padding:2px 0;">&nbsp;&nbsp;Routed (LIVE)</td><td style="padding:2px 8px;"><strong>{{ review.order_funnel.routed_live }}</strong></td></tr>
  <tr><td style="padding:2px 0;">&nbsp;&nbsp;Filled</td>
      <td style="padding:2px 8px;"><strong>{{ review.order_funnel.filled_live }}</strong>
        {% if review.order_funnel.partial_live %}<span style="color:{{ ui.MUTED }};">(+{{ review.order_funnel.partial_live }} partial)</span>{% endif %}
      </td></tr>
  <tr><td style="padding:2px 0;">&nbsp;&nbsp;Accepted, not auto-routed</td>
      <td style="padding:2px 8px;"><strong>{{ review.order_funnel.accepted_not_routed }}</strong>
        <span style="color:{{ ui.MUTED }}; font-size:11px;">{% if review.auto_trade_mode == 'LIVE' %}(presumed manual){% else %}(auto-trade not LIVE){% endif %}</span></td></tr>
  <tr><td style="padding:2px 0;">Rejected</td><td style="padding:2px 8px;">{{ review.order_funnel.rejected }}</td></tr>
  <tr><td style="padding:2px 0;">Expired</td><td style="padding:2px 8px;">{{ review.order_funnel.expired }}</td></tr>
  {% if review.order_funnel.dry_run_count and review.order_flow %}
  <tr><td colspan="2" style="color:{{ ui.MUTED }}; font-size:11px; padding-top:6px;">
    DRY_RUN (simulated): {{ review.order_funnel.dry_run_count }} executions —
    ${{ "%.2f"|format(review.order_flow.dry_run_buy_usd) }} buys, ${{ "%.2f"|format(review.order_flow.dry_run_sell_usd) }} sells
  </td></tr>
  {% endif %}
</table>

{% if review.order_flow %}
{{ ui.subsection("Dollar flow (LIVE)") }}
<table role="presentation" cellpadding="0" cellspacing="0" style="border-collapse:collapse; font-family:Arial,Helvetica,sans-serif; font-size:13px; margin:0 0 12px 0; color:{{ ui.BODY }};">
  <tr>
    <td style="padding:2px 12px 2px 0;">Buys routed</td><td style="padding:2px 16px 2px 0;">${{ "%.2f"|format(review.order_flow.buy_routed_usd) }}</td>
    <td style="padding:2px 12px 2px 0;">Buys filled</td><td>${{ "%.2f"|format(review.order_flow.buy_filled_usd) }}</td>
  </tr>
  <tr>
    <td style="padding:2px 12px 2px 0;">Sells routed</td><td style="padding:2px 16px 2px 0;">${{ "%.2f"|format(review.order_flow.sell_routed_usd) }}</td>
    <td style="padding:2px 12px 2px 0;">Sells filled</td><td>${{ "%.2f"|format(review.order_flow.sell_filled_usd) }}</td>
  </tr>
  <tr><td style="padding:2px 0;">Distinct tickers w/ activity</td><td colspan="3" style="padding:2px 8px;"><strong>{{ review.order_flow.distinct_tickers }}</strong></td></tr>
</table>
{% endif %}

{% if review.drift_rows %}
{{ ui.subsection("Allocation drift (Mon → Fri)") }}
<div class="sscroll" style="overflow-x:auto; -webkit-overflow-scrolling:touch;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse; font-family:Arial,Helvetica,sans-serif; font-size:12px; margin:0 0 12px 0;">
  <thead>
    <tr style="background:{{ ui.HEADBG }}; color:{{ ui.MUTED }}; border-bottom:1px solid {{ ui.LINE2 }};">
      <th align="left"  style="padding:3px 8px;">Ticker</th>
      <th align="right" style="padding:3px 8px;">Target%</th>
      <th align="right" style="padding:3px 8px;">Mon%</th>
      <th align="right" style="padding:3px 8px;">Fri%</th>
      <th align="right" style="padding:3px 8px;">Drift (pp)</th>
      <th style="padding:3px 8px;"></th>
    </tr>
  </thead>
  <tbody>
    {% for r in review.drift_rows %}
    {% set drift_color = ui.MUTED if (r.drift_pp|abs) < 0.005 else (ui.POS if r.moved_toward_target else ui.NEG) %}
    <tr style="border-bottom:1px solid {{ ui.LINE }}; color:{{ ui.BODY }};">
      <td style="padding:3px 8px;">{{ r.ticker }}{% if r.monday_is_fallback %}*{% endif %}</td>
      <td align="right" style="padding:3px 8px;">{{ "%.1f"|format(r.target_pct) }}</td>
      <td align="right" style="padding:3px 8px;">{{ "%.1f"|format(r.current_pct_mon) }}</td>
      <td align="right" style="padding:3px 8px;">{{ "%.1f"|format(r.current_pct_fri) }}</td>
      <td align="right" style="padding:3px 8px; color:{{ drift_color }}; font-weight:bold;">{{ "%+.2f"|format(r.drift_pp) }}</td>
      <td style="padding:3px 8px; color:{{ drift_color }};">{{ "→ unchanged" if (r.drift_pp|abs) < 0.005 else ("→ closer" if r.moved_toward_target else "→ farther") }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>
{% if review.drift_rows[0].targets_changed_midweek %}
<p style="font-family:Arial,Helvetica,sans-serif; font-size:11px; color:{{ ui.MUTED }}; margin:0 0 8px 0;">Targets were edited mid-week; drift includes the target-shift component.</p>
{% endif %}
{% if review.drift_rows | selectattr("monday_is_fallback") | list %}
<p style="font-family:Arial,Helvetica,sans-serif; font-size:11px; color:{{ ui.MUTED }}; margin:0 0 8px 0;">* Monday was a market holiday; the most recent prior snapshot was used as the baseline.</p>
{% endif %}
{% endif %}

{% if review.etf_trend %}
{{ ui.subsection("ETF trend (vs 200-day MA)") }}
<div class="sscroll" style="overflow-x:auto; -webkit-overflow-scrolling:touch;">
<table role="presentation" cellpadding="0" cellspacing="0" style="border-collapse:collapse; font-family:Arial,Helvetica,sans-serif; font-size:12px; margin:0 0 20px 0;">
  <thead>
    <tr style="background:{{ ui.HEADBG }}; color:{{ ui.MUTED }}; border-bottom:1px solid {{ ui.LINE2 }};">
      <th align="left"  style="padding:3px 8px;">ETF</th>
      <th align="right" style="padding:3px 8px;">Price</th>
      <th align="right" style="padding:3px 8px;">200-day MA</th>
      <th align="right" style="padding:3px 8px;">% vs MA200</th>
    </tr>
  </thead>
  <tbody>
    {% for e in review.etf_trend %}
    <tr style="border-bottom:1px solid {{ ui.LINE }}; color:{{ ui.BODY }};">
      <td style="padding:3px 8px;">{{ e.ticker }}</td>
      <td align="right" style="padding:3px 8px;">{{ "${:.2f}".format(e.close) }}</td>
      <td align="right" style="padding:3px 8px;">{{ "${:.2f}".format(e.sma_200) if e.sma_200 is not none else "—" }}</td>
      <td align="right" style="padding:3px 8px; color:{{ ui.POS if (e.pct_from_sma_200 is not none and e.pct_from_sma_200 >= 0) else ui.NEG }};">{{ "%+.1f%%"|format(e.pct_from_sma_200) if e.pct_from_sma_200 is not none else "—" }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>
{% endif %}

{% if review.trend_rows %}
{{ ui.subsection("4-week trend") }}
<div class="sscroll" style="overflow-x:auto; -webkit-overflow-scrolling:touch;">
<table role="presentation" cellpadding="0" cellspacing="0" style="border-collapse:collapse; font-family:Arial,Helvetica,sans-serif; font-size:12px; margin:0 0 20px 0;">
  <thead>
    <tr style="background:{{ ui.HEADBG }}; color:{{ ui.MUTED }}; border-bottom:1px solid {{ ui.LINE2 }};">
      <th align="left"  style="padding:3px 8px;">Week of</th>
      <th align="center" style="padding:3px 8px;">Suggested</th>
      <th align="center" style="padding:3px 8px;">Filled+&#x2202;</th>
      <th align="right"  style="padding:3px 8px;">$ buys</th>
      <th align="right"  style="padding:3px 8px;">$ sells</th>
      <th align="right"  style="padding:3px 8px;">|&Sigma; drift|</th>
    </tr>
  </thead>
  <tbody>
    {% for w in review.trend_rows %}
    <tr style="border-bottom:1px solid {{ ui.LINE }}; color:{{ ui.BODY }};">
      <td style="padding:3px 8px;">{{ w.week_of.strftime("%b %d") }}</td>
      <td align="center" style="padding:3px 8px;">{{ w.suggested }}</td>
      <td align="center" style="padding:3px 8px;">{{ w.filled_live }}</td>
      <td align="right"  style="padding:3px 8px;">${{ "%.0f"|format(w.buy_filled_usd) }}</td>
      <td align="right"  style="padding:3px 8px;">${{ "%.0f"|format(w.sell_filled_usd) }}</td>
      <td align="right"  style="padding:3px 8px;">{{ "%.2f"|format(w.abs_drift_pp_sum) }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>
{% endif %}
{% endif %}

{# ---- Weekly market context ---- #}
{% if review.market_context %}
{{ ui.section("Weekly Market Context") }}
{% if review.market_context.macro_summary %}
{{ ui.subsection("Macro") }}
<p style="font-family:Arial,Helvetica,sans-serif; font-size:13px; color:{{ ui.BODY }}; margin:0 0 12px 0; line-height:1.5;">{{ review.market_context.macro_summary }}</p>
{% endif %}
{% if review.market_context.sector_summary %}
{{ ui.subsection("Sectors") }}
<p style="font-family:Arial,Helvetica,sans-serif; font-size:13px; color:{{ ui.BODY }}; margin:0 0 12px 0; line-height:1.5;">{{ review.market_context.sector_summary }}</p>
{% endif %}
{% if review.market_context.ticker_catchup %}
{{ ui.subsection("Ticker Catch-Up") }}
<ul style="font-family:Arial,Helvetica,sans-serif; font-size:13px; color:{{ ui.BODY }}; margin:0 0 12px 0; padding-left:20px; line-height:1.5;">
  {% for ticker, summary in review.market_context.ticker_catchup.items() %}
  <li style="margin-bottom:4px;"><strong>{{ ticker }}:</strong> {{ summary }}</li>
  {% endfor %}
</ul>
{% endif %}
{% if review.market_context.forward_events %}
{{ ui.subsection("Next Week") }}
<ul style="font-family:Arial,Helvetica,sans-serif; font-size:13px; color:{{ ui.BODY }}; margin:0 0 12px 0; padding-left:20px; line-height:1.5;">
  {% for event in review.market_context.forward_events %}
  <li style="margin-bottom:4px;">{{ event }}</li>
  {% endfor %}
</ul>
{% endif %}
{% if review.market_context.citations %}
<p style="font-family:Arial,Helvetica,sans-serif; font-size:11px; color:{{ ui.MUTED }}; margin:8px 0 2px 0;"><strong>Sources</strong></p>
<ol style="font-family:Arial,Helvetica,sans-serif; font-size:11px; color:{{ ui.MUTED }}; margin:0 0 20px 0; padding-left:20px;">
  {% for cite in review.market_context.citations[:10] %}
  <li style="margin-bottom:2px;"><a href="{{ cite.url }}" style="color:{{ ui.MUTED }};">{{ cite.title }}</a> ({{ cite.source_domain }})</li>
  {% endfor %}
</ol>
{% endif %}
{% endif %}

{# ---- Moomoo status ---- #}
{{ ui.section("Moomoo Status") }}
{% if review.moomoo_status == 'primary' %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#eef4fb; border:1px solid #b6d4ea; border-radius:8px; margin:0 0 20px 0;">
  <tr><td style="padding:12px 16px; font-family:Arial,Helvetica,sans-serif; font-size:13px; color:#1a5276;">Moomoo is the <strong>primary broker</strong> — live trading enabled.</td></tr>
</table>
{% elif review.moomoo_status == 'parallel_running' %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f1faf3; border:1px solid #bfe3cb; border-radius:8px; margin:0 0 20px 0;">
  <tr><td style="padding:12px 16px; font-family:Arial,Helvetica,sans-serif; font-size:13px; color:{{ ui.POS }};">Moomoo OpenD is <strong>running in parallel</strong> — data sync active, not primary broker.</td></tr>
</table>
{% else %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:{{ ui.ROWALT }}; border:1px solid {{ ui.LINE }}; border-radius:8px; margin:0 0 20px 0;">
  <tr><td style="padding:12px 16px; font-family:Arial,Helvetica,sans-serif; font-size:13px; color:{{ ui.MUTED }};">Moomoo OpenD is <strong>unavailable</strong> — not configured or not reachable.</td></tr>
</table>
{% endif %}

{{ ui.footer("No orders are placed automatically. Log into your broker to act on any suggestion.",
             review.week_of.strftime('%Y-%m-%d')) }}

</body>
</html>
